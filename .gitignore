# 外来库 / 自带 .git 的第三方仓库：不入库（磁盘上保留）
/luanti/
/mineflayer/

# Python
__pycache__/
*.pyc
*.pyo

# vla_env venv / build artifacts
/vla_env/.venv/
/vla_env/*.egg-info/

# Node (tools/agents)
/tools/agents/node_modules/

# Gradle (fabric-vla-client)
/fabric-vla-client/.gradle/
/fabric-vla-client/build/

# OS
.DS_Store

# tools/ws_harness 下载的依赖 jar（ws_harness.sh 自动补齐）
/tools/ws_harness/libs/

# CodeBuddy 会话内临时文件（scheduled_tasks 锁等）
/.codebuddy/

# demo 视频等生成产物（磁盘保留不入库）
/datasets/
